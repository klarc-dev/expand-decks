# Database (used by docker-compose for postgres service)
DATABASE_URL=postgresql://payload:payload@postgres:5432/slides
POSTGRES_DB=slides
POSTGRES_USER=payload
POSTGRES_PASSWORD=change-me-in-production

# Payload CMS
PAYLOAD_SECRET=generate-a-random-secret-here

# Payload Postgres schema push is opt-in. Leave unset/0 for normal dev and
# maintenance scripts; set to 1 only when you deliberately want Payload to push
# local schema changes into the dev database (may prompt on destructive changes).
PAYLOAD_DB_PUSH=0

# AI — the same CloudCLIProxy endpoint and ckey used by Hermes.
# OPENAI_BASE_URL / OPENAI_API_KEY remain supported as compatibility fallbacks.
# Drafting uses tool calling, so any deliberate OPENAI_MODEL override must also
# support function calling.
CLIPROXYAPI_BASE_URL=https://klarc.tail769c37.ts.net:8317/v1
CLIPROXYAPI_KEY=your-cloudcliproxy-ckey
OPENAI_MODEL=high
# Optional per-phase routing. Each falls back to OPENAI_MODEL, then `high`.
# Use these only after the versioned `pnpm test:agent-evals` gate passes.
# OPENAI_RESEARCH_MODEL=high
# OPENAI_DRAFT_MODEL=high
# OPENAI_JUDGE_MODEL=high
# OPENAI_VISUAL_MODEL=high

# Agent sources — optional runtime registry for source-aware agentic builds.
# This stays server-side: the admin UI only receives id/label, never command/env/url secrets.
# JSON array. Supported transports:
# Every source MUST declare an explicit non-empty read-only `allowedTools` list.
# The connector fails closed if the server does not advertise every allowed tool.
# - stdio: {"id":"fiscal-kb","label":"Fiscal KB","transport":"stdio","command":"npx","args":["-y","my-mcp-server"],"env":{"API_KEY":"..."},"allowedTools":["search","read"]}
# - http:  {"id":"docs","label":"Docs","transport":"http","url":"https://example.com/mcp","allowedTools":["search","read"]}
AGENT_SOURCE_REGISTRY_JSON=[]

# Mastra Postgres schema migrations run explicitly during deployment with
# `pnpm mastra:migrate`; production runtime disables implicit concurrent init.
MASTRA_DISABLE_INIT=1

# Google OAuth (admin login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Dev server port + URL. PORT is a hardcoded uncommon port so it never collides
# with 3000; `pnpm dev` frees it before starting. NEXT_PUBLIC_SERVER_URL MUST
# match PORT — Payload's CSRF check compares the request Origin to serverURL, and
# a mismatch silently nulls req.user (writes 403, admin "must be logged in").
PORT=4317
NEXT_PUBLIC_SERVER_URL=http://localhost:4317

# Seed admin — optional. If both are set, payload.config onInit upserts this
# admin on every boot (creates if missing, otherwise resets password + role).
# Leave unset in production unless you want a guaranteed admin login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Optional
NEXT_TELEMETRY_DISABLED=1

# Optional Google Fonts Webfonts API key. Enables live font-family catalog in
# admin/AI paths; render/export falls back to built-in font names when missing.
# GOOGLE_FONTS_API_KEY=

# Number of payload-worker replicas (parallel presentation builds). Default 2.
# Keep <= host cores - 1; each build spawns Chromium + Vite (mem_limit 2g each).
WORKER_REPLICAS=2
