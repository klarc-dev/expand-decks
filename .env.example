# Database (used by docker-compose for postgres service)
DATABASE_URL=postgresql://payload:payload@postgres:5432/slides
POSTGRES_DB=slides
POSTGRES_USER=payload
POSTGRES_PASSWORD=change-me-in-production

# Payload CMS
PAYLOAD_SECRET=generate-a-random-secret-here

# Payload Postgres schema push is opt-in. Leave unset/0 for normal dev and
# maintenance scripts; set to 1 only when you deliberately want Payload to push
# local schema changes into the dev database (may prompt on destructive changes).
PAYLOAD_DB_PUSH=0

# AI — any OpenAI-compatible endpoint (OpenAI direct, omniroute, LiteLLM, OpenRouter…).
# Drafting uses tool calling, so OPENAI_MODEL must be a model the endpoint serves
# AND must support function calling. For the omniroute gateway, model IDs are
# namespaced (cc/ Claude, cx/ GPT, ds/ DeepSeek) — a bare name 404s there.
#   OpenAI direct : OPENAI_BASE_URL=https://api.openai.com/v1   OPENAI_MODEL=gpt-5-mini
#   omniroute     : OPENAI_BASE_URL=https://<host>:20129/v1     OPENAI_MODEL=cc/claude-sonnet-4-6
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-or-proxy-api-key
OPENAI_MODEL=gpt-5-mini

# Agent sources — optional runtime registry for source-aware agentic builds.
# This stays server-side: the admin UI only receives id/label, never command/env/url secrets.
# JSON array. Supported transports:
# - stdio: {"id":"fiscal-kb","label":"Fiscal KB","transport":"stdio","command":"npx","args":["-y","my-mcp-server"],"env":{"API_KEY":"..."}}
# - http:  {"id":"docs","label":"Docs","transport":"http","url":"https://example.com/mcp"}
AGENT_SOURCE_REGISTRY_JSON=[]

# Google OAuth (admin login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Dev server port + URL. PORT is a hardcoded uncommon port so it never collides
# with 3000; `pnpm dev` frees it before starting. NEXT_PUBLIC_SERVER_URL MUST
# match PORT — Payload's CSRF check compares the request Origin to serverURL, and
# a mismatch silently nulls req.user (writes 403, admin "must be logged in").
PORT=4317
NEXT_PUBLIC_SERVER_URL=http://localhost:4317

# Seed admin — optional. If both are set, payload.config onInit upserts this
# admin on every boot (creates if missing, otherwise resets password + role).
# Leave unset in production unless you want a guaranteed admin login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Optional
NEXT_TELEMETRY_DISABLED=1

# Number of payload-worker replicas (parallel presentation builds). Default 2.
# Keep <= host cores - 1; each build spawns Chromium + Vite (mem_limit 2g each).
WORKER_REPLICAS=2

# Set to 1 to restore the slower per-slide PDF export. Only needed if a real-PDF
# footer page-counter regression ever surfaces; default (unset) is single-pass.
# SLIDEV_EXPORT_PER_SLIDE=1

# Native Slidev export tuning. Defaults: timeout 120000ms, no TOC. Mermaid decks
# use Slidev's --wait-until networkidle + a 4000ms settle wait automatically.
# SLIDEV_EXPORT_TIMEOUT_MS=120000
# SLIDEV_EXPORT_WITH_TOC=1
