{
  "name": "expand-decks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:dx": "node scripts/dev-dx.mjs",
    "prebuild": "cp node_modules/@payloadcms/next/dist/prod/styles.css src/app/\\(payload\\)/payload-admin.css",
    "build": "next build",
    "start": "next start",
    "payload": "payload",
    "mastra:migrate": "MASTRA_DISABLE_INIT=0 tsx --env-file-if-exists=.env scripts/mastra-migrate.ts",
    "deck:mcp": "tsx --env-file-if-exists=.env scripts/deck-mcp.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "jobs:run": "payload jobs:run --queue default",
    "deck:seed": "tsx --env-file-if-exists=.env scripts/run-seed.ts",
    "deck:build": "tsx --env-file-if-exists=.env scripts/run-build.ts",
    "deck:dump": "tsx --env-file-if-exists=.env scripts/dump-slides-md.ts",
    "users:import": "tsx --env-file-if-exists=.env scripts/import-users.ts",
    "login": "node --env-file=.env scripts/login.mjs",
    "test": "vitest run",
    "test:agent-evals": "tsx --env-file-if-exists=.env scripts/evals/run-live.ts && tsx --env-file-if-exists=.env scripts/evals/run-revision.ts",
    "eval:ci": "tsx scripts/evals/run-ci.ts",
    "eval:live": "tsx --env-file-if-exists=.env scripts/evals/run-live.ts",
    "eval:revision": "tsx --env-file-if-exists=.env scripts/evals/run-revision.ts",
    "eval:seed": "tsx --env-file-if-exists=.env scripts/evals/seed-datasets.ts",
    "eval:experiment": "tsx --env-file-if-exists=.env scripts/evals/run-experiment.ts",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome lint .",
    "check:fix": "biome lint --write .",
    "lint:dead": "fallow",
    "lint:dead:scan": "fallow dead-code",
    "lint:dead:fix": "fallow fix --dry-run",
    "lint:dead:ci": "fallow audit --gate new-only --format json",
    "lint:dead:prod": "fallow dead-code --production",
    "prepare": "lefthook install"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@mastra/core": "^1.61.0",
    "@mastra/evals": "1.9.0",
    "@mastra/mcp": "^1.17.1",
    "@mastra/observability": "1.17.1",
    "@mastra/pg": "^1.21.1",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "gray-matter": "^4.0.3",
    "mermaid": "11.17.2",
    "next": "16.3.3",
    "payload": "3.88.0",
    "payload-auth-plugin": "^0.7.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.103.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@next/eslint-plugin-next": "16.3.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "fallow": "^3.18.0",
    "kill-port": "^2.0.1",
    "lefthook": "^2.1.10",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
