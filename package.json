{
  "name": "expand-decks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:dx": "node scripts/dev-dx.mjs",
    "prebuild": "cp node_modules/@payloadcms/next/dist/prod/styles.css src/app/\\(payload\\)/payload-admin.css",
    "build": "next build",
    "start": "next start",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "jobs:run": "payload jobs:run --queue default",
    "deck:seed": "tsx --env-file-if-exists=.env scripts/run-seed.ts",
    "deck:build": "tsx --env-file-if-exists=.env scripts/run-build.ts",
    "deck:dump": "tsx --env-file-if-exists=.env scripts/dump-slides-md.ts",
    "login": "node --env-file=.env scripts/login.mjs",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome lint .",
    "check:fix": "biome lint --write .",
    "lint:dead": "fallow",
    "lint:dead:scan": "fallow dead-code",
    "lint:dead:fix": "fallow fix --dry-run",
    "lint:dead:ci": "fallow audit --gate new-only --format json",
    "lint:dead:prod": "fallow dead-code --production",
    "prepare": "lefthook install"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.29",
    "@mastra/core": "^1.57.0",
    "@mastra/mcp": "^1.15.1",
    "@mastra/pg": "^1.19.0",
    "@payloadcms/db-postgres": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/richtext-lexical": "3.87.1",
    "@payloadcms/translations": "3.87.1",
    "@payloadcms/ui": "3.87.1",
    "gray-matter": "^4.0.3",
    "mermaid": "11.16.1",
    "next": "16.3.0",
    "payload": "3.87.1",
    "payload-auth-plugin": "^0.7.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@next/eslint-plugin-next": "16.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "fallow": "^3.14.0",
    "kill-port": "^2.0.1",
    "lefthook": "^2.1.10",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
