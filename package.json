{
  "name": "expand-decks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:dx": "node scripts/dev-dx.mjs",
    "prebuild": "cp node_modules/@payloadcms/next/dist/prod/styles.css src/app/\\(payload\\)/payload-admin.css",
    "build": "next build",
    "start": "next start",
    "payload": "payload",
    "mastra:migrate": "MASTRA_DISABLE_INIT=0 tsx --env-file-if-exists=.env scripts/mastra-migrate.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "generate:agent-skills": "tsx scripts/generate-agent-skills.ts",
    "generate:agent-skills:check": "tsx scripts/generate-agent-skills.ts --check",
    "jobs:run": "payload jobs:run --queue default",
    "prod": "node scripts/prod.mjs",
    "deck:seed": "tsx --env-file-if-exists=.env scripts/run-seed.ts",
    "deck:build": "tsx --env-file-if-exists=.env scripts/run-build.ts",
    "deck:dump": "tsx --env-file-if-exists=.env scripts/dump-slides-md.ts",
    "documents:generate": "tsx --env-file-if-exists=.env scripts/generate-documents.ts",
    "users:import": "tsx --env-file-if-exists=.env scripts/import-users.ts",
    "login": "node --env-file=.env scripts/login.mjs",
    "test": "vitest run",
    "test:agent-evals": "tsx --env-file-if-exists=.env scripts/evals/run-live.ts && tsx --env-file-if-exists=.env scripts/evals/run-revision.ts",
    "eval:ci": "tsx scripts/evals/run-ci.ts",
    "eval:retrieval-embedding-threshold": "tsx scripts/evals/retrieval-embedding-threshold.mts",
    "eval:live": "tsx --env-file-if-exists=.env scripts/evals/run-live.ts",
    "eval:revision": "tsx --env-file-if-exists=.env scripts/evals/run-revision.ts",
    "eval:seed": "tsx --env-file-if-exists=.env scripts/evals/seed-datasets.ts",
    "eval:experiment": "tsx --env-file-if-exists=.env scripts/evals/run-experiment.ts",
    "test:e2e": "pnpm exec playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome lint .",
    "check:fix": "biome lint --write .",
    "lint:dead": "fallow",
    "lint:dead:scan": "fallow dead-code",
    "lint:dead:fix": "fallow fix --dry-run",
    "lint:dead:ci": "fallow audit --gate new-only --format json",
    "lint:dead:prod": "fallow dead-code --production",
    "prepare": "lefthook install"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.49",
    "@mastra/core": "^1.67.0",
    "@mastra/evals": "1.10.2",
    "@mastra/fastembed": "1.3.1",
    "@mastra/observability": "1.17.8",
    "@mastra/pg": "^1.25.0",
    "@mastra/rag": "2.6.3",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/translations": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.46.0",
    "mammoth": "1.12.3",
    "mermaid": "12.0.0",
    "next": "16.3.5",
    "payload": "3.89.0",
    "payload-auth-plugin": "^0.7.13",
    "pdf-lib": "1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.104.1",
    "sharp": "^0.35.4",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@next/eslint-plugin-next": "16.3.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "fallow": "^3.26.0",
    "kill-port": "^2.0.1",
    "lefthook": "^2.1.14",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
