{
  "name": "expand-decks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "cp node_modules/@payloadcms/next/dist/prod/styles.css src/app/\\(payload\\)/payload-admin.css",
    "build": "next build",
    "start": "next start",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "jobs:run": "payload jobs:run --queue default",
    "login": "node --env-file=.env scripts/login.mjs",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome lint .",
    "check:fix": "biome lint --write .",
    "lint:dead": "fallow",
    "lint:dead:scan": "fallow dead-code",
    "lint:dead:fix": "fallow fix --dry-run",
    "lint:dead:ci": "fallow audit --gate new-only --format json",
    "lint:dead:prod": "fallow dead-code --production",
    "prepare": "lefthook install"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.1",
    "@mastra/core": "^1.47.0",
    "@mastra/mcp": "^1.12.0",
    "@mastra/pg": "^1.14.2",
    "@payloadcms/db-postgres": "3.85.1",
    "@payloadcms/live-preview-react": "3.85.1",
    "@payloadcms/next": "3.85.1",
    "@payloadcms/richtext-lexical": "3.85.1",
    "@payloadcms/translations": "3.85.1",
    "@payloadcms/ui": "3.85.1",
    "ai": "^7.0.4",
    "gray-matter": "^4.0.3",
    "mermaid": "11.16.0",
    "next": "16.2.9",
    "payload": "3.85.1",
    "payload-auth-plugin": "^0.7.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.101.0",
    "sharp": "^0.35.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@next/eslint-plugin-next": "16.2.9",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.6.0",
    "fallow": "^2.103.0",
    "lefthook": "^2.1.9",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9",
    "vite": "^8.1.0"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": ">=7.5.8 <8",
      "@protobufjs/utf8": ">=1.1.1",
      "fast-uri": ">=3.1.2",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "uuid@<11.1.1": ">=11.1.1 <12",
      "qs@>=6.11.1 <6.15.2": ">=6.15.2",
      "postcss@<8.5.10": ">=8.5.10",
      "dompurify@<3.4.0": ">=3.4.0",
      "js-cookie@<3.0.7": ">=3.0.7 <4",
      "esbuild@<0.25.0": ">=0.28.1",
      "undici@>=7.0.0 <7.28.0": "7.28.0",
      "dompurify@<3.4.11": ">=3.4.11",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "vite@>=8.0.0 <8.0.16": ">=8.0.16",
      "js-yaml@<3.15.0": ">=3.15.0 <4",
      "js-yaml@>=4.0.0 <4.2.0": ">=4.2.0 <5",
      "esbuild@>=0.25.0 <0.28.1": ">=0.28.1"
    }
  }
}
